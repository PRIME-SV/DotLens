{
  "manifest_version": 3,
  "name": "DotLens: Social Feed Filter",
  "version": "0.3.2",
  "description": "Filter X and Reddit posts by keywords and phrases. Hide distractions and track filtering with local analytics.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://reddit.com/*",
        "https://www.reddit.com/*",
        "https://old.reddit.com/*",
        "https://new.reddit.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "short_name": "DotLens"
}
